{
  "name": "react-markdown-typewriter",
  "version": "2.0.0",
  "description": "React Markdown component (powered by @tanstack/markdown) with a typewriter effect animated with motion.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup --config tsup.config.ts",
    "lint": "biome lint",
    "check": "biome check",
    "format": "biome format --write",
    "playground": "npm run build && npm run dev --workspace=playground"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DRincs-Productions/react-markdown-typewriter.git"
  },
  "author": "DRincs-Productions",
  "bugs": {
    "url": "https://github.com/DRincs-Productions/react-markdown-typewriter/issues"
  },
  "homepage": "https://github.com/DRincs-Productions/react-markdown-typewriter",
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "emoji-regex": "^10.6.0",
    "html-tags": "^5.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "motion": ">=12.9.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@tanstack/markdown": "^1.0.0"
  },
  "keywords": [
    "ast",
    "commonmark",
    "component",
    "gfm",
    "markdown",
    "react",
    "react-component",
    "tanstack",
    "html",
    "javascript animation",
    "react animation",
    "animation",
    "motion",
    "framer",
    "typewriter"
  ]
}
